# Variáveis de ambiente do INKA.
#
# O projeto lê as variáveis direto do ambiente (no Render, em Environment).
# Este arquivo é só um modelo: não coloque senhas de verdade aqui.

# Chave secreta do Django. Obrigatória no Render. Ela também protege os hashes
# dos códigos de redefinição de senha.
SECRET_KEY=

# Envio de e-mail por SMTP (código de redefinição e aviso de senha alterada).
# Sem EMAIL_HOST: no computador o e-mail aparece no terminal; no Render ele é
# descartado.
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Use TLS na porta 587, ou SSL na porta 465. Nunca os dois como True.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Remetente que aparece nos e-mails.
DEFAULT_FROM_EMAIL=INKA <nao-responda@exemplo.com>
